# ProductIQ env keys (dev only — never commit this file)
GROQ_API_KEY=your-groq-key-here
NVIDIA_API_KEY=your-nvidia-key-here
GOOGLE_API_KEY=your-google-key-here
TAVILY_API_KEY=your-tavily-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Admin seed (change from defaults immediately)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Research / MCP configuration
TAVILY_MCP_COMMAND=npx
TAVILY_MCP_ARGS=-y tavily-mcp
RESEARCH_CACHE_TTL_HOURS=6
RESEARCH_MONTHLY_BUDGET=900
RESEARCH_TIMEOUT_SECONDS=20
